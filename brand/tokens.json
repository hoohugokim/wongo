      {"name": "annotation", "x": 172, "y": 0, "width": 20, "height": 20, "color": "annotation"},
      {"name": "text-1", "x": 0, "y": 38, "width": 84, "height": 24, "color": "ink"},
      {"name": "text-2", "x": 0, "y": 80, "width": 84, "height": 24, "color": "ink"},
      {"name": "text-3", "x": 0, "y": 118, "width": 60, "height": 24, "color": "ink"},
      {"name": "figure", "x": 96, "y": 32, "width": 96, "height": 74, "color": "petrol"},
      {"name": "caption-1", "x": 96, "y": 114, "width": 96, "height": 14, "color": "ink"},
      {"name": "caption-2", "x": 96, "y": 136, "width": 68, "height": 14, "color": "ink"}
