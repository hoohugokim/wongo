{
  "name": "Wongo",
  "version": "1.0.0",
  "approved": "2026-10-02",
  "direction": "C — abstract manuscript grid with serif wordmark",
  "color": {
    "ink": "#21313D",
    "petrol": "#416C78",
    "annotation": "#C56852",
    "paper": "#FFFFFF",
    "surface": "#F3F5F5",
    "muted": "#52636D",
    "rule": "#CCD5D9",
    "success": "#3B705C",
    "warning": "#8A651D",
    "danger": "#A0413C"
  },
  "typography": {
    "serif": "Source Serif 4",
    "sans": "Source Sans 3",
    "korean": "Noto Sans KR",
    "mono": "Source Code Pro",
